# mate configuration — copy to .env, fill in, chmod 600.
# .env holds real credentials: never commit it, never paste it into logs.
# The worker loads it via `set -a && source .env && set +a` (see README).

# --- required ----------------------------------------------------------

# Callers allowed through the worker's gate (comma-separated E.164).
# The phone-facing worker (dev/start) refuses to run without this, and
# any SIP caller not on the list is hung up on before Mate speaks.
MATE_ALLOWED_NUMBERS=+15555550100

# Spoken passphrase, exactly four words. Caller ID can be spoofed, so on
# top of the allowlist every phone caller must say this phrase before
# Mate will do anything; three misses and it hangs up. Matching ignores
# case and punctuation but needs all four words, in order. The worker
# refuses to start without it (prompts if run from a terminal) unless
# you set MATE_REQUIRE_PASSPHRASE=0.
MATE_PASSPHRASE="correct horse battery staple"
#MATE_REQUIRE_PASSPHRASE=1

# LiveKit Cloud project the worker registers with (Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- optional: local endpoint overrides (defaults shown) ---------------

# OpenAI-compatible local services. Any server speaking the same API
# works; these are the defaults for the reference stack (llama.cpp,
# speaches/faster-whisper, kokoro-fastapi).
#LLM_URL=http://localhost:8003/v1
#STT_URL=http://localhost:8001/v1
#TTS_URL=http://localhost:8880/v1
#LLM_MODEL=qwen3.6-35b-a3b-long
#STT_MODEL=Systran/faster-whisper-medium
#TTS_VOICE=af_heart

# Voice brain on the OpenAI API instead of a local model: set all three.
# API-key usage billing only — a ChatGPT subscription has no API access.
# A real key (anything but the default "local") skips the qwen-tuned
# local sampling knobs; the provider's defaults apply. Note everything
# Mate hears and reads then leaves your machine (see README threat model).
#LLM_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-5-mini
#LLM_API_KEY=sk-...

# --- optional: paths ---------------------------------------------------

# herdr's control socket.
#HERDR_SOCKET=~/.config/herdr/herdr.sock

# Colon-separated roots spawn_in_folder searches for projects by name.
#MATE_SRC_ROOTS=~/src

# Where Claude Code writes session transcripts (agent_report reads them).
#MATE_CLAUDE_PROJECTS=~/.claude/projects

# --- optional: unused by mate itself -----------------------------------

# Handy for managing your DID/trunk via Telnyx API tooling; mate never
# reads it.
#TELNYX_API_KEY=
